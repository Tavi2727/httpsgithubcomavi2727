      },
      "auditTrail": [
        {
          "stage": "idempotency_check",
          "timestamp": "2026-04-01T09:18:00Z",
          "result": "DUPLICATE_DETECTED",
          "cachedResult": {
            "originalRequestId": "REQ-20260401-001",
            "originalTimestamp": "2026-04-01T09:15:00Z",
            "finalStatus": "approved"
          },
          "action": "RETURN_CACHED_RESULT"
        }
      ],
      "finalStatus": "approved",
      "decisionSummary": "Duplicate request detected via idempotency key. Returned cached result from original submission REQ-20260401-001. No reprocessing occurred."
    },
