        "submittedAt": "2026-04-01T10:00:00Z",
        "applicantName": "Rahul Verma",
        "loanAmount": 80000,
        "loanPurpose": "vehicle",
        "applicant": {
          "employmentStatus": "employed",
          "annualIncome": 450000,
          "dateOfBirth": "1995-07-20",
          "ageYears": 30
        }
      },
      "externalResults": {
        "creditCheckResult": {
          "score": 580,
          "activeDefaults": 0,
          "fetchedAt": "2026-04-01T10:00:02Z",
          "attempts": 1
        }
      },
      "auditTrail": [
        {
          "stage": "input_validation",
          "timestamp": "2026-04-01T10:00:00Z",
          "rules": [
            { "ruleId": "REQUIRED_FIELDS", "result": "PASS" },
            { "ruleId": "EMPLOYMENT_STATUS", "actual": "employed", "result": "PASS" },
            { "ruleId": "MIN_AGE", "actual": 30, "result": "PASS" },
            { "ruleId": "MIN_LOAN_AMOUNT", "actual": 80000, "result": "PASS" }
          ],
          "stageOutcome": "PASS",
          "transition": "credit_check"
        },
        {
          "stage": "credit_check",
          "timestamp": "2026-04-01T10:00:02Z",
          "rules": [
            {
              "ruleId": "MIN_CREDIT_SCORE",
