    {
      "exampleId": "EX-003",
      "scenario": "Manual Review — External Dependency Failure (Max Retries Exceeded)",
      "input": {
        "requestId": "REQ-20260401-003",
        "idempotencyKey": "c3d4e5f6-a7b8-9012-cdef-123456789012",
        "submittedAt": "2026-04-01T11:30:00Z",
        "applicantName": "Anjali Mehta",
        "loanAmount": 200000,
        "loanPurpose": "business",
        "applicant": {
          "employmentStatus": "self_employed",
          "annualIncome": 1200000,
          "ageYears": 42
        }
      },
      "auditTrail": [
        {
          "stage": "input_validation",
          "timestamp": "2026-04-01T11:30:00Z",
          "stageOutcome": "PASS",
          "transition": "credit_check"
        },
        {
          "stage": "credit_check",
          "timestamp": "2026-04-01T11:30:01Z",
          "externalDependency": {
            "service": "CreditCheckService",
            "attempts": [
              { "attempt": 1, "timestamp": "2026-04-01T11:30:01Z", "status": "TIMEOUT", "waitMs": 3000 },
              { "attempt": 2, "timestamp": "2026-04-01T11:30:05Z", "status": "TIMEOUT", "waitMs": 3000 },
              { "attempt": 3, "timestamp": "2026-04-01T11:30:11Z", "status": "TIMEOUT", "waitMs": 3000 }
            ],
            "finalStatus": "MAX_RETRIES_EXCEEDED"
          },
          "stageOutcome": "DEPENDENCY_FAILURE",
          "transition": "manual_review"
        }
      ],
      "finalStatus": "manual_review",
      "decisionSummary": "Automated decision not possible. CreditCheckService timed out on all 3 retry attempts. Application escalated to manual review queue for human agent decision."
    },
    {
      "exampleId": "EX-004",
