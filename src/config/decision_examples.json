  "examples": [
    {
      "exampleId": "EX-001",
      "scenario": "Happy Path — Full Approval",
      "input": {
        "requestId": "REQ-20260401-001",
        "idempotencyKey": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
        "submittedAt": "2026-04-01T09:15:00Z",
        "applicantName": "Priya Sharma",
        "loanAmount": 120000,
        "loanPurpose": "home_purchase",
        "applicant": {
          "employmentStatus": "employed",
          "annualIncome": 850000,
          "dateOfBirth": "1990-03-15",
          "ageYears": 36
        }
      },
      "externalResults": {
        "creditCheckResult": {
          "score": 720,
          "activeDefaults": 0,
          "fetchedAt": "2026-04-01T09:15:02Z",
          "attempts": 1
        }
      },
      "computedFields": {
        "debtToIncomeRatio": 0.18,
        "incomeToRepaymentRatio": 5.9
      },
      "auditTrail": [
        {
          "stage": "input_validation",
          "timestamp": "2026-04-01T09:15:00Z",
          "rules": [
            { "ruleId": "REQUIRED_FIELDS", "result": "PASS" },
            { "ruleId": "EMPLOYMENT_STATUS", "actual": "employed", "threshold": ["employed","self_employed"], "result": "PASS" },
            { "ruleId": "MIN_AGE", "actual": 36, "threshold": 18, "result": "PASS" },
            { "ruleId": "MIN_LOAN_AMOUNT", "actual": 120000, "threshold": 10000, "result": "PASS" }
          ],
          "stageOutcome": "PASS",
          "transition": "credit_check"
        },
        {
          "stage": "credit_check",
          "timestamp": "2026-04-01T09:15:02Z",
          "externalDependency": { "service": "CreditCheckService", "attempts": 1, "status": "SUCCESS" },
          "rules": [
            { "ruleId": "MIN_CREDIT_SCORE", "actual": 720, "threshold": 650, "result": "PASS" },
            { "ruleId": "NO_ACTIVE_DEFAULTS", "actual": 0, "threshold": 0, "result": "PASS" }
          ],
          "stageOutcome": "PASS",
          "transition": "risk_scoring"
        },
        {
          "stage": "risk_scoring",
          "timestamp": "2026-04-01T09:15:02Z",
          "rules": [
            { "ruleId": "MAX_LOAN_AMOUNT", "actual": 120000, "threshold": 500000, "result": "PASS" },
            { "ruleId": "DEBT_TO_INCOME_RATIO", "actual": 0.18, "threshold": 0.45, "result": "PASS" },
            { "ruleId": "MIN_ANNUAL_INCOME", "actual": 5.9, "threshold": 3.0, "result": "PASS" }
          ],
          "stageOutcome": "PASS",
          "transition": "final_decision"
        },
        {
          "stage": "final_decision",
          "timestamp": "2026-04-01T09:15:03Z",
          "rules": [
            { "ruleId": "LOAN_PURPOSE_ALLOWED", "actual": "home_purchase", "threshold": ["home_purchase","..."], "result": "PASS" }
          ],
          "stageOutcome": "PASS",
          "transition": "approved"
        }
      ],
      "finalStatus": "approved",
      "decisionSummary": "All 10 rules passed across 4 stages. Application approved automatically."
    },
    {
      "exampleId": "EX-002",
